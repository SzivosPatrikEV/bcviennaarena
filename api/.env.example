# MySQL / MariaDB connection (phpMyAdmin manages the database; the app connects to its server)
# Use the MySQL hostname from your hosting control panel. phpMyAdmin's
# "Server: localhost" label does not necessarily mean the app should use localhost.
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=bcvienna_bcviennaarena
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Existing application settings
ADMIN_PASSWORD=choose_a_strong_password
PORT=3000
